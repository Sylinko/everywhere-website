/assets/*
  Cache-Control: public, max-age=31536000, immutable

/en
  Content-Language: en

/en/*
  Content-Language: en

/zh
  Content-Language: zh-CN

/zh/*
  Content-Language: zh-CN

/llms.txt
  Content-Type: text/markdown; charset=utf-8

/:lang/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Link: <https://everywhere.sylinko.com/llms.txt>; rel="describedby"

/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/:lang/docs.md
  Link: <https://everywhere.sylinko.com/:lang/docs>; rel="canonical", <https://everywhere.sylinko.com/llms.txt>; rel="describedby"

/:lang/docs/*.md
  Link: <https://everywhere.sylinko.com/:lang/docs/:splat>; rel="canonical", <https://everywhere.sylinko.com/llms.txt>; rel="describedby"

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
