{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everywhere-website",
  "main": "src/server.ts",
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/*/",
      "/en",
      "/en/*",
      "/zh",
      "/zh/*"
    ]
  },
  "compatibility_date": "2026-11-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "issues": {
      "enabled": true
    }
  },
  "services": [
    {
      "binding": "EVERYWHERE_AI_GATEWAY",
      "service": "everywhere-ai-gateway-production",
      "entrypoint": "GatewayBinding",
    },
  ],
  "env": {
    "dev": {
      "services": [
        {
          "binding": "EVERYWHERE_AI_GATEWAY",
          "service": "everywhere-ai-gateway",
          "entrypoint": "GatewayBinding",
        },
      ],
    },
  },
}
