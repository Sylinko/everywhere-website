{
  "name": "everywhere-website",
  "scripts": {
    "build": "pnpm og && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "upload": "pnpm build && wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "og": "tsx scripts/generate-og.ts",
    "start": "vite preview --port 3000",
    "types:check": "fumadocs-mdx && tsr generate && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fumadocs/language": "0.2.21",
    "@paper-design/shaders-react": "^0.0.82",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.7",
    "lucide-react": "^1.78.0",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.5",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-cli": "1.168.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^10.15.0",
    "gray-matter": "^4.0.3",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "wrangler": "^4.166.0"
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module"
}
